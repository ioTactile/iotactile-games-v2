{
	"name": "api",
	"version": "0.0.1",
	"description": "api",
	"author": "ioTactile Games <jbs.io@protonmail.com>",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc --noEmit",
		"start": "tsx src/server.ts",
		"audit": "pnpm audit --audit-level=high || exit 0",
		"test": "vitest",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:e2e": "vitest run --e2e",
		"test:e2e:watch": "vitest --e2e --watch",
		"test:e2e:coverage": "vitest run --e2e --coverage",
		"test:e2e:ui": "vitest --e2e --ui",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"type:check": "tsc --noEmit",
		"check": "biome check && tsc --noEmit",
		"check:fix": "biome check --write && tsc --noEmit",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "^11.3.0",
		"@fastify/jwt": "^10.2.2",
		"@fastify/websocket": "^11.3.1",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bcrypt": "^6.0.0",
		"dotenv": "^18.0.4",
		"fastify": "^5.12.5",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"prisma": "^7.10.0",
		"redis": "^6.2.1",
		"typescript-result": "^3.5.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^26.6.3",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^5.0.2",
		"@vitest/ui": "^5.0.2",
		"pino-pretty": "^13.1.3",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.2"
	}
}
